# Generated by abox {{ abox_version }} for project "{{ project }}" — DO NOT EDIT.
#
# Built and run by abox through the Docker CLI directly. There is deliberately
# no dependency on @devcontainers/cli — nothing abox needs is installed with npm
# on the host, and Claude Code comes from its checksum-verified native binary
# rather than an npm package.
#
# Everything the agent gets is baked here: containers are disposable, so an
# install-on-every-run would need archive egress in the window before the
# firewall exists.
FROM {{ base_image }}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Firewall tooling plus the handful of utilities the install steps below need.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      iptables \
      ipset \
      dnsmasq \
      dnsutils \
      iproute2 \
      procps \
      ca-certificates \
      curl \
      jq \
      git \
      xz-utils \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------- Claude Code ----
# The official installer places a launcher and a version store under $HOME,
# which the persistent ~/.claude volume would shadow at run time. abox fetches
# the same artifact the installer does — same URL, same manifest, same sha256
# check — and puts it somewhere no mount can hide.
ARG CLAUDE_VERSION={{ claude_version }}
RUN set -euo pipefail; \
    case "$(dpkg --print-architecture)" in \
      amd64) platform="linux-x64" ;; \
      arm64) platform="linux-arm64" ;; \
      *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    base="https://downloads.claude.ai/claude-code-releases"; \
    version="${CLAUDE_VERSION}"; \
    if [ "${version}" = "latest" ] || [ "${version}" = "stable" ]; then \
      version="$(curl -fsSL "${base}/latest")"; \
    fi; \
    echo "${version}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+' || { \
      echo "not a valid Claude Code version: ${version}" >&2; exit 1; }; \
    checksum="$(curl -fsSL "${base}/${version}/manifest.json" \
      | jq -r --arg p "${platform}" '.platforms[$p].checksum // empty')"; \
    echo "${checksum}" | grep -Eq '^[a-f0-9]{64}$' || { \
      echo "no checksum published for ${platform} at ${version}" >&2; exit 1; }; \
    curl -fsSL -o /tmp/claude "${base}/${version}/${platform}/claude"; \
    echo "${checksum}  /tmp/claude" | sha256sum -c -; \
    install -m 0755 /tmp/claude /usr/local/bin/claude; \
    rm -f /tmp/claude; \
    echo "${version}" > /opt/abox-claude-version

{% if "python" in toolchains %}
# ------------------------------------------------------------- python ------
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-dev \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3 /usr/local/bin/python
# uv is a single static binary; no pip bootstrap, no npm, nothing to compile.
RUN curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh
{% endif %}
{% if "go" in toolchains %}
# ----------------------------------------------------------------- go ------
ARG GO_VERSION={{ versions.go }}
RUN set -euo pipefail; \
    arch="$(dpkg --print-architecture)"; \
    curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" \
      | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}" GOPATH="/home/{{ remote_user }}/go"
{% endif %}
{% if "node" in toolchains %}
# --------------------------------------------------------------- node ------
# Node lands *inside the container* because the project asked for it. Nothing
# about abox itself needs it, and the host stays npm-free either way.
ARG NODE_VERSION={{ versions.node }}
RUN set -euo pipefail; \
    case "$(dpkg --print-architecture)" in \
      amd64) narch="x64" ;; arm64) narch="arm64" ;; \
      *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${narch}.tar.xz" \
      | tar -C /usr/local --strip-components=1 -xJ
{% endif %}
{% if "rust" in toolchains %}
# --------------------------------------------------------------- rust ------
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --profile minimal \
 && chmod -R a+rX "${RUSTUP_HOME}" "${CARGO_HOME}"
ENV PATH="/usr/local/cargo/bin:${PATH}"
{% endif %}
{% if "java" in toolchains %}
RUN apt-get update && apt-get install -y --no-install-recommends default-jdk \
 && rm -rf /var/lib/apt/lists/*
{% endif %}
{% if "ruby" in toolchains %}
RUN apt-get update && apt-get install -y --no-install-recommends ruby-full \
 && rm -rf /var/lib/apt/lists/*
{% endif %}
{% if "php" in toolchains %}
RUN apt-get update && apt-get install -y --no-install-recommends php-cli \
 && rm -rf /var/lib/apt/lists/*
{% endif %}
{% if "dotnet" in toolchains %}
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && bash /tmp/dotnet-install.sh --channel LTS --install-dir /usr/local/dotnet \
 && rm -f /tmp/dotnet-install.sh
ENV PATH="/usr/local/dotnet:${PATH}" DOTNET_CLI_TELEMETRY_OPTOUT=1
{% endif %}

{% if rtk.enabled %}

# ------------------------------------------------------------------ rtk ----
# A CLI proxy that filters verbose command output before it reaches the model.
# Fetched from the project's own release assets and checked against the
# `checksums.txt` published alongside them — the same discipline as the Claude
# Code binary above, because this one ends up in the agent's command path.
ARG RTK_VERSION={{ rtk.version }}
RUN set -euo pipefail; \
    case "$(dpkg --print-architecture)" in \
      arm64) asset="rtk-aarch64-unknown-linux-gnu.tar.gz" ;; \
      amd64) asset="rtk-x86_64-unknown-linux-musl.tar.gz" ;; \
      *) echo "no rtk build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/{{ rtk.repo }}/releases/download/v${RTK_VERSION}"; \
    curl -fsSL -o /tmp/rtk.tar.gz "${base}/${asset}"; \
    curl -fsSL -o /tmp/rtk-checksums.txt "${base}/checksums.txt"; \
    want="$(grep -F "${asset}" /tmp/rtk-checksums.txt | awk '{print $1}' | head -1)"; \
    echo "${want}" | grep -Eq '^[a-f0-9]{64}$' || { \
      echo "no checksum published for ${asset}" >&2; exit 1; }; \
    echo "${want}  /tmp/rtk.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/rtk.tar.gz -C /tmp; \
    install -m 0755 "$(find /tmp -maxdepth 2 -type f -name rtk | head -1)" /usr/local/bin/rtk; \
    rm -rf /tmp/rtk.tar.gz /tmp/rtk-checksums.txt; \
    rtk --version
{% endif %}

# ------------------------------------------------------------ hardening ----
# The agent needs no root at all: abox applies the firewall itself, as root,
# through the Docker socket it holds on the host. So sudo is removed outright
# rather than neutered — a present-but-defanged setuid binary is one config
# mistake away from working again, and nothing here has any use for it.
#
# SUDO_FORCE_REMOVE is the package's own escape hatch: its prerm otherwise
# refuses, warning that you will lose administrative access. Losing it is the
# point — abox reaches root through the Docker socket, and root's password stays
# locked so `su` is not a path either.
#
# The trailing assertions are build-time: an image that still ships sudo, as a
# binary or as dpkg state something could reinstall against, must fail to build
# rather than quietly ship.
RUN (SUDO_FORCE_REMOVE=yes DEBIAN_FRONTEND=noninteractive apt-get purge -y sudo || true) \
 && rm -f /usr/bin/sudo /usr/bin/sudo.ws /usr/bin/sudoedit /usr/bin/sudoreplay* \
          /usr/bin/cvtsudoers* /usr/sbin/visudo* /usr/sbin/sudo_logsrvd \
          /usr/sbin/sudo_sendlog* \
 && rm -rf /etc/sudoers /etc/sudoers.d /usr/libexec/sudo /usr/lib/sudo \
 && (gpasswd -d {{ remote_user }} sudo 2>/dev/null || true) \
 && (delgroup sudo 2>/dev/null || true) \
 && rm -rf /var/lib/apt/lists/* \
 && install -d -m 0755 -o {{ remote_user }} -g {{ remote_user }} /home/{{ remote_user }}/.claude \
 && install -d -m 0755 -o root -g root /var/log/abox \
 && install -d -m 0755 /opt/abox \
 && ! command -v sudo \
 && ! dpkg -l sudo 2>/dev/null | grep -q "^ii"

USER {{ remote_user }}
WORKDIR /workspace
ENV CLAUDE_CONFIG_DIR="/home/{{ remote_user }}/.claude" \
    PATH="/home/{{ remote_user }}/.local/bin:${PATH}"
LABEL abox.project="{{ project }}" abox.base="{{ base_image }}"
